+### Optima independent of the plotting window
+The grid above is for plotting. The calculation below searches every affordable integer dish count, so the reported optima do not depend on the 60 m² plot limit. Sub-5λ dishes remain mathematical extrapolations, marked dashed above.
+
+
+# Optimize dishes over all affordable integer counts, independently of the plot grid.
+# For alpha < -1 the rate increases with area at fixed n, so each candidate uses
+# the largest affordable area. At alpha = -1 use the smallest displayed area.
+def optimal_dish(budget, frequency, slope, min_area=0.1):
+    if slope > -1:
+        raise ValueError("This optimizer covers the modeled slopes alpha <= -1.")
+    max_count = findn(budget, frequency, min_area)
+    if max_count == 0:
+        raise ValueError("Budget cannot afford one dish at min_area.")
+    counts = np.arange(1, max_count + 1, dtype=np.float64)
+    processing = (k1 + k2 * np.log2(counts)) * f * frequency
+    areas = np.power((budget / counts - processing) / D0, 1 / 1.25)
+    if slope == -1:
+        areas[:] = min_area
+    # Round downward if the inverse calculation lands just above the budget.
+    costs = (D0 * areas**1.25 + processing) * counts
+    while np.any(costs > budget):
+        over = costs > budget
+        areas[over] = np.nextafter(areas[over], 0.0)
+        costs = (D0 * areas**1.25 + processing) * counts
+    rates = frbrate(areas, frequency, counts, slope)
+    best = np.argmax(rates)
+    return float(areas[best]), int(counts[best]), float(rates[best])
+
+print("Dish optima (area m^2, integer count, rate /yr); alpha=-1 uses A>=0.1 m^2")
+for slope in alpha:
+    for frequency in nu:
+        area_best, count_best, rate_best = optimal_dish(cost, frequency, slope)
+        print(f"alpha={slope:4.1f}, nu={frequency:4.0f} MHz: "
+              f"{area_best:8.4f}, {count_best:4d}, {rate_best:12.3f}")
